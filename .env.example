# ==========================================
# HOSPITAL AGENTIC PLATFORM - ENVIRONMENT CONFIG
# ==========================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=hospital_core
POSTGRES_HOST=hospital_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password_here@hospital_db:5432/hospital_core

# Backend API Configuration
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENT_INTERNAL_SECRET=your_agent_internal_secret_token_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OFFER_EXPIRATION_MINUTES=15

# n8n Orchestrator Configuration
N8N_PORT=5678
N8N_ENCRYPTION_KEY=your_n8n_32_character_encryption_key_here
N8N_HOST=localhost
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=hospital_db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=hospital_n8n
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=your_secure_password_here
N8N_WEBHOOK_URL=http://hospital_n8n:5678/webhook

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api

