        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "appointment_id",
              "value": "={{ $fromAI(\"appointment_id\", \"The appointment ID integer\", \"number\") }}"
            },
            {
              "name": "reason",
              "value": "={{ $fromAI(\"reason\", \"Escalation reason string\", \"string\") }}"
            }
          ]
        }
      },
      "id": "tool-escalate-admin",
      "name": "Tool: Escalate to Admin",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        680,
        780
      ]
    }
  ],
