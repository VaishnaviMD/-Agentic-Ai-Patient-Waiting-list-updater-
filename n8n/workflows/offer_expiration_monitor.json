{
  "name": "CareFlow - Offer Expiration Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "cron-expiration-trigger",
      "name": "1-Minute Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/process-expired-offers",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "http-sweep-expired",
      "name": "Sweep Expired Offers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-any-expired",
      "name": "Any Expired Offers Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  for (const exp of item.json.expired_offers) {\n    items.push({ json: exp });\n  }\n}\nreturn items;"
      },
      "id": "code-split-expired",
      "name": "Extract Each Expired Offer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/next-candidate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"appointment_id\": {{ $json.appointment_id }} }"
      },
      "id": "http-query-next-after-expiry",
      "name": "Query Next Candidate for Slot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 240]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_next }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-candidate-after-expiry",
      "name": "Next Candidate Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/create-offer",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"appointment_id\": {{ $json.appointment_id }}, \"patient_id\": {{ $json.next_candidate.patient_id }}, \"waitlist_id\": {{ $json.next_candidate.waitlist_id }}, \"expiry_minutes\": 15 }"
      },
      "id": "http-create-offer-expiry",
      "name": "Create Offer for Subsequent Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/notify-patient",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"patient_id\": {{ $json.patient_id }}, \"offer_id\": {{ $json.offer_id }}, \"notification_type\": \"offer_created\" }"
      },
      "id": "http-notify-patient-expiry",
      "name": "Notify Subsequent Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1740, 180]
    }
  ],
  "connections": {
    "1-Minute Cron Trigger": {
      "main": [
        [
          {
            "node": "Sweep Expired Offers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sweep Expired Offers": {
      "main": [
        [
          {
            "node": "Any Expired Offers Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Expired Offers Found?": {
      "main": [
        [
          {
            "node": "Extract Each Expired Offer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Each Expired Offer": {
      "main": [
        [
          {
            "node": "Query Next Candidate for Slot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Next Candidate for Slot": {
      "main": [
        [
          {
            "node": "Next Candidate Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Next Candidate Exists?": {
      "main": [
        [
          {
            "node": "Create Offer for Subsequent Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Offer for Subsequent Patient": {
      "main": [
        [
          {
            "node": "Notify Subsequent Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}

