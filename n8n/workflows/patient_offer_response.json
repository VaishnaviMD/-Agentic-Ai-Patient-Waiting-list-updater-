{
  "name": "CareFlow - Patient Offer Response Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "patient-offer-response",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-offer-response",
      "name": "Offer Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.status }}",
        "rules": {
          "rules": [
            {
              "value2": "accepted"
            },
            {
              "value2": "declined"
            }
          ]
        }
      },
      "id": "switch-offer-status",
      "name": "Check Response Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/next-candidate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"appointment_id\": {{ $('Offer Response Webhook').item.json.body.appointment_id }} }"
      },
      "id": "http-query-next-candidate",
      "name": "Query Next Candidate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 420]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_next }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-candidate-exists",
      "name": "Candidate Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/create-offer",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"appointment_id\": {{ $json.appointment_id }}, \"patient_id\": {{ $json.next_candidate.patient_id }}, \"waitlist_id\": {{ $json.next_candidate.waitlist_id }}, \"expiry_minutes\": 15 }"
      },
      "id": "http-create-next-offer",
      "name": "Create Offer for Next Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/notify-patient",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"patient_id\": {{ $json.patient_id }}, \"offer_id\": {{ $json.offer_id }}, \"notification_type\": \"offer_created\" }"
      },
      "id": "http-notify-next-patient",
      "name": "Notify Next Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 340]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://hospital_backend:8000/api/v1/agent/escalate-to-admin",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Agent-Secret",
              "value": "agent_internal_shared_secret_hospital_ai_2026"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"appointment_id\": {{ $('Offer Response Webhook').item.json.body.appointment_id }}, \"reason\": \"Previous candidate declined and no further eligible waitlist patients remain for this slot.\" }"
      },
      "id": "http-escalate-exhausted",
      "name": "Escalate to Admin (Queue Exhausted)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 520]
    }
  ],
  "connections": {
    "Offer Response Webhook": {
      "main": [
        [
          {
            "node": "Check Response Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response Status": {
      "main": [
        [],
        [
          {
            "node": "Query Next Candidate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Next Candidate": {
      "main": [
        [
          {
            "node": "Candidate Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Candidate Exists?": {
      "main": [
        [
          {
            "node": "Create Offer for Next Patient",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalate to Admin (Queue Exhausted)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Offer for Next Patient": {
      "main": [
        [
          {
            "node": "Notify Next Patient",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}

